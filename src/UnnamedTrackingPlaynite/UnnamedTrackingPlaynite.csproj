<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>UnnamedTrackingPlaynite</AssemblyName>
    <RootNamespace>UnnamedTrackingPlaynite</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Release CI overrides Version from the GitHub release tag. -->
    <Version Condition="'$(Version)' == ''">0.1.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.17.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StampExtensionManifest" AfterTargets="Build">
    <WriteLinesToFile
      File="$(TargetDir)extension.yaml"
      Lines="Id: UnnamedTrackingPlaynite;Name: Unnamed Tracking;Author: Rosefall-a;Version: $(Version);Module: UnnamedTrackingPlaynite.dll;Type: GenericPlugin;Links:;    - Name: Source;      Url: https://github.com/Rosefall-a/UnnamedTrackingPlaynite"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>
</Project>
