<UserControl x:Class="UnnamedTrackingPlaynite.UnnamedTrackingSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="API URL" FontWeight="SemiBold" />
        <TextBox Margin="0,5,0,12" Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="Base URL for the Unnamed Tracking service." />
        <TextBlock Text="Authentication token" FontWeight="SemiBold" />
        <TextBox Margin="0,5,0,12" Text="{Binding AuthValue, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="The authentication token is stored with this Playnite extension's settings." TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
</UserControl>
