<UserControl x:Class="UnnamedTrackingPlaynite.SaveSyncDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Unnamed Tracking — Save Sync" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,12"
                   Text="Manage every configured save location, see pending changes, and sync individual games without leaving Playnite."
                   TextWrapping="Wrap" Foreground="#D8D8D8" />
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SortCombo" Width="150" SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="Status" IsSelected="True" />
                    <ComboBoxItem Content="Game name" />
                    <ComboBoxItem Content="File count" />
                </ComboBox>
                <Button Content="Expand all" Margin="10,0,0,0" Padding="10,4" Click="ExpandAll_Click" />
                <Button Content="Collapse all" Margin="6,0,0,0" Padding="10,4" Click="CollapseAll_Click" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="Open Unnamed Tracking" Click="OpenApplication_Click" Margin="0,0,8,0" />
                <Button Content="Cancel sync" Click="CancelSync_Click" Margin="0,0,8,0" />
                <Button x:Name="UploadButton" Content="Sync selected" IsEnabled="False" Margin="6,0,0,0" Padding="10,4" Click="SyncUpload_Click" />
                <Button x:Name="DownloadButton" Content="Download selected" IsEnabled="False" Margin="6,0,0,0" Padding="10,4" Click="SyncDownload_Click" />
                <Button x:Name="ConfigureButton" Content="Configure selected" IsEnabled="False" Margin="6,0,0,0" Padding="10,4" Click="Configure_Click" />
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#D8D8D8" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" />
        </ScrollViewer>
    </Grid>
</UserControl>