<UserControl x:Class="UnnamedTrackingPlaynite.SavePathDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16" MinWidth="700">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Click="Save_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Save locations" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,12"
                       Text="Add the folders or files used by this game. Give each location a name so it is easy to identify. The paths stay on this PC and are never uploaded."
                       TextWrapping="Wrap"/>
            <Button Content="+ Add save location" HorizontalAlignment="Left" Padding="14,6" Click="Add_Click"/>
            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Path" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EntriesPanel"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
