<UserControl x:Class="UnnamedTrackingPlaynite.SavePathDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16" MinWidth="620">
        <TextBlock Text="Local save folders" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,12" Text="Enter one folder per line. Environment variables such as %USERPROFILE% are expanded when syncing." TextWrapping="Wrap"/>
        <TextBox x:Name="PathsBox" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
